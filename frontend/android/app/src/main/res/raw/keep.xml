<?xml version="1.0" encoding="utf-8"?>
<!-- The Android Auto / lock-screen buttons (audio_handler.dart MediaControl
     androidIcon) are looked up BY NAME at runtime, which the release build's
     resource shrinker can't see. Without this it stripped ic_favorite*,
     ic_*_on and ic_speed from beta 184, and the car's Now Playing screen
     errored on the heart button's missing icon (Nov 6). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_favorite,@drawable/ic_favorite_on,@drawable/ic_shuffle,@drawable/ic_shuffle_on,@drawable/ic_repeat,@drawable/ic_repeat_on,@drawable/ic_speed,@drawable/ic_stat_nasradio,@drawable/ic_thumb_down" />
