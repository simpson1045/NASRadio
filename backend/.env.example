# NASRadio Backend Environment Variables
# Copy this file to .env and fill in your values

SECRET_KEY=change-me-to-a-random-string

# Spotify API (get from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_SP_DC=

# Lidarr
LIDARR_URL=http://your-nas-ip:8686
LIDARR_API_KEY=

# Prowlarr
PROWLARR_URL=http://your-nas-ip:9696
PROWLARR_API_KEY=

# Transmission
TRANSMISSION_URL=http://your-nas-ip:9091
TRANSMISSION_USER=
TRANSMISSION_PASS=

# Transmission auto-restart (Synology-era, default off): when Transmission is
# unreachable, SSH into the host running it and bounce its docker-compose
# stack, then retry. Requires NAS_SSH_PASSWORD and a host where this recipe
# actually applies.
TRANSMISSION_AUTO_RESTART=false
NAS_SSH_HOST=your-nas-ip
NAS_SSH_PORT=22
NAS_SSH_USER=
NAS_SSH_PASSWORD=
TRANSMISSION_COMPOSE_DIR=/docker/transmission
TRANSMISSION_RESTART_COOLDOWN=90
# Synology's /docker dir + docker socket are root-only, so the restart uses sudo
# (password fed via stdin). Set false only if your NAS user can run docker-compose directly.
TRANSMISSION_RESTART_USE_SUDO=true

# CORS: comma-separated browser origins allowed to reach the API/WebSocket
# (your app's addresses - LAN IP, hostname, public domain). Use * to allow all.
# Leave unset to keep the built-in defaults (localhost + this repo's dev hosts).
#CORS_ALLOWED_ORIGINS=http://localhost:5002,https://music.example.com

# Artwork source API keys (free to register): https://www.last.fm/api ·
# https://fanart.tv/get-an-api-key · https://acoustid.org/api-key
#LASTFM_API_KEY=
#FANART_API_KEY=
#ACOUSTID_API_KEY=

# Optional sidecar services. Both degrade gracefully when absent:
# Essentia ML analysis (genres/mood/BPM/ReplayGain stay dormant without it),
# desktop transcode service (falls back to local ffmpeg).
#ESSENTIA_SERVICE_URL=http://127.0.0.1:5005
#NASRADIO_TRANSCODE_URL=http://127.0.0.1:5006

# Database
DATABASE_URL=postgresql://nasradio:nasradio@localhost:5432/nasradio

# Music library path - UNC share on Windows, local dir/mount on Linux
# (containers default to /music, the compose bind-mount)
MUSIC_LIBRARY_PATH=\\your-nas-ip\Music

# Prefixes of OLD library locations still present in DB rows after a library
# move (comma-separated, e.g. \\oldnas\Music). Leave unset on a fresh install.
#LEGACY_LIBRARY_PREFIXES=

# Podcast downloads
PODCAST_DOWNLOAD_DIR=\\your-nas-ip\Music\Podcasts

# Download paths
DOWNLOADS_NASRADIO=\\your-nas-ip\downloads\complete\nasradio
DOWNLOADS_LIDARR=\\your-nas-ip\downloads\complete\lidarr

# ── Server identity ──────────────────────────────────────────────────
# Listen address/port (default 0.0.0.0:5002)
#HOST=0.0.0.0
#PORT=5002
# How this server is reached from outside - used in cast stream URLs, party
# join links/QR codes and the MusicBrainz callback. Empty = the address the
# request came in on.
#PUBLIC_BASE_URL=https://music.example.com
# Contact sent in the User-Agent to MusicBrainz and similar APIs
#CONTACT_EMAIL=you@example.com

# ── Headless cast sender (optional living-room control) ──────────────
# All of these can also be set in the app under Settings → Cast.
#CAST_DEVICE_HOST=192.168.1.50          # default Chromecast/TV to cast to
#CAST_DEVICE_WOL_MAC=aa:bb:cc:dd:ee:ff  # wake the TV first (empty = don't)
#CAST_WOL_BROADCAST=192.168.1.255       # your LAN broadcast address
#CAST_RECEIVER_APP_ID=                  # your registered Cast app ID (receiver URL = PUBLIC_BASE_URL/cast/receiver.html)
#DENON_HOST=                            # Denon/Marantz receiver IP (empty = no AVR control)
#DENON_TELNET_PORT=23
#DENON_INPUT_CMD=SITV                   # telnet command selecting the TV/eARC input

# NOTE: everything from SPOTIFY_* down to the cast block above is a runtime
# setting - values saved in the app (Settings → Integrations, admin only)
# override this file without a restart. SECRET_KEY, DATABASE_URL, HOST, PORT
# and CORS are bootstrap-only and must be set here.
