# NASRadio - docker compose configuration. Copy to .env and edit.
#
# Only MUSIC_DIR is required. Everything under "Backend settings" can be left
# blank and filled in later from the app (Settings > Integrations, admin only);
# values saved in the app override this file without a restart.

# ---- Host paths --------------------------------------------------------------
# Your music library on this host (mounted read-write at /music in the container).
MUSIC_DIR=/path/to/your/music
# Finished downloads from Transmission/Lidarr (optional; mounted at /downloads).
#DOWNLOADS_DIR=/path/to/downloads

# ---- Stack -------------------------------------------------------------------
# Port the API and app connect to on this host.
NASRADIO_PORT=5002
# Postgres credentials for the bundled database (change the password).
POSTGRES_USER=nasradio
POSTGRES_PASSWORD=nasradio
POSTGRES_DB=nasradio
# Memory caps for the optional sidecars (docker compose --profile analysis).
#ESSENTIA_MEM_LIMIT=3g
#TRANSCODE_MEM_LIMIT=2g

# ---- Backend settings (all optional) -----------------------------------------
# Signs login tokens. Leave unset and the backend generates one and keeps it
# in its data volume. Set it if you want to control it.
#SECRET_KEY=

# Browser origins allowed on the API/WebSocket, comma-separated. Native apps
# do not need this. Set it if you use the web build or a public hostname.
#CORS_ALLOWED_ORIGINS=https://music.example.com

# How this server is reached from outside (cast stream URLs, party links,
# MusicBrainz callback). Empty = the address each request came in on.
#PUBLIC_BASE_URL=https://music.example.com
#CONTACT_EMAIL=you@example.com

# Download stack (optional). Inside the container "localhost" is the
# container itself; use the host's LAN IP or a docker network name.
#TRANSMISSION_URL=http://192.168.1.10:9091
#TRANSMISSION_USER=
#TRANSMISSION_PASS=
#TRANSMISSION_DOWNLOAD_DIR=/downloads/complete/nasradio
#PROWLARR_URL=http://192.168.1.10:9696
#PROWLARR_API_KEY=
#LIDARR_URL=http://192.168.1.10:8686
#LIDARR_API_KEY=

# Metadata and artwork APIs (all free to register).
#LASTFM_API_KEY=          # https://www.last.fm/api
#FANART_API_KEY=          # https://fanart.tv/get-an-api-key
#SPOTIFY_CLIENT_ID=       # https://developer.spotify.com/dashboard
#SPOTIFY_CLIENT_SECRET=
#SPOTIFY_SP_DC=           # unofficial; only for Spotify play counts
#PODCAST_INDEX_KEY=       # https://api.podcastindex.org
#PODCAST_INDEX_SECRET=
#ACOUSTID_API_KEY=        # https://acoustid.org/api-key

# yt-dlp cookies for age-gated YouTube videos: copy a cookies.txt into the
# backend_data volume and point at it (container path).
#YT_DLP_COOKIES_FILE=/app/data/youtube_cookies.txt

# Headless cast (the SERVER casts to a TV on its own). Optional.
#CAST_DEVICE_HOST=192.168.1.50
#CAST_DEVICE_WOL_MAC=aa:bb:cc:dd:ee:ff
#CAST_WOL_BROADCAST=192.168.1.255
#CAST_RECEIVER_APP_ID=            # your registered Cast app ID (receiver URL = PUBLIC_BASE_URL/cast/receiver.html)
#DENON_HOST=                      # Denon/Marantz receiver IP for volume/input control
#DENON_TELNET_PORT=23
#DENON_INPUT_CMD=SITV
